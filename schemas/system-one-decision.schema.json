{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.org/schemas/nl-dsl-llm/system-one-decision.schema.json",
  "title": "Wellmanifest System One / Jev Typed Decision Envelope",
  "description": "Single-pass typed decision contract (choice, score, noul) for DockURI Action URIs and canonical DSL statements.",
  "type": "object",
  "required": [
    "schema",
    "model_id",
    "model_family",
    "questions",
    "answers",
    "probabilities",
    "selected_uri",
    "confidence",
    "risk_score",
    "execution_allowed",
    "latency_ms"
  ],
  "additionalProperties": false,
  "$defs": {
    "actionUri": {
      "type": "string",
      "minLength": 7,
      "pattern": "^[a-z][a-z0-9+.-]*://[A-Za-z0-9._-]+(?:/[A-Za-z0-9._:@-]+)+(?:[?][A-Za-z0-9._~%&=-]+)?$"
    },
    "canonicalDsl": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*(?:\\s+\\S+)*$"
    },
    "probability": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "properties": {
    "schema": {
      "const": "wellmanifest.system-one-decision/v1"
    },
    "model_id": {
      "type": "string",
      "enum": [
        "clef-27b",
        "clef-flash-9b",
        "gliner2.5-decide-340m",
        "laya-322m-multilingual",
        "laya-mlx-322m",
        "kev-4b",
        "semif-qwen3.5-4b",
        "nanojev-0.6b",
        "bespoke-nimble-9b",
        "jevlike-scorer",
        "jevos-v3-cpu"
      ]
    },
    "model_family": {
      "type": "string",
      "enum": [
        "Clef",
        "Clef-flash",
        "GLiNER2.5-Decide",
        "Laya",
        "Laya-MLX",
        "Kev",
        "SemIf",
        "NanoJev",
        "Bespoke-Nimble",
        "jevlike",
        "jevos"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "object",
          "required": [
            "name",
            "type",
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "uri_choice"
            },
            "type": {
              "const": "choice"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 255,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/actionUri"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "name",
            "type",
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "risk_score"
            },
            "type": {
              "const": "score"
            },
            "options": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                {
                  "const": "1"
                },
                {
                  "const": "2"
                },
                {
                  "const": "3"
                }
              ],
              "items": false
            }
          }
        },
        {
          "type": "object",
          "required": [
            "name",
            "type",
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "execution_allowed"
            },
            "type": {
              "const": "noul"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "const": "yes"
                },
                {
                  "const": "no"
                }
              ],
              "items": false
            }
          }
        }
      ],
      "items": false
    },
    "answers": {
      "type": "object",
      "required": [
        "uri_choice",
        "risk_score",
        "execution_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "uri_choice": {
          "$ref": "#/$defs/actionUri"
        },
        "risk_score": {
          "type": "string",
          "enum": [
            "1",
            "2",
            "3"
          ]
        },
        "execution_allowed": {
          "type": "string",
          "enum": [
            "yes",
            "no"
          ]
        }
      }
    },
    "probabilities": {
      "type": "object",
      "required": [
        "uri_choice",
        "risk_score",
        "execution_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "uri_choice": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/actionUri"
          },
          "additionalProperties": {
            "$ref": "#/$defs/probability"
          }
        },
        "risk_score": {
          "type": "object",
          "required": [
            "1",
            "2",
            "3"
          ],
          "additionalProperties": false,
          "properties": {
            "1": {
              "$ref": "#/$defs/probability"
            },
            "2": {
              "$ref": "#/$defs/probability"
            },
            "3": {
              "$ref": "#/$defs/probability"
            }
          }
        },
        "execution_allowed": {
          "type": "object",
          "required": [
            "yes",
            "no"
          ],
          "additionalProperties": false,
          "properties": {
            "yes": {
              "$ref": "#/$defs/probability"
            },
            "no": {
              "$ref": "#/$defs/probability"
            }
          }
        }
      }
    },
    "selected_uri": {
      "$ref": "#/$defs/actionUri"
    },
    "selected_dsl": {
      "$ref": "#/$defs/canonicalDsl"
    },
    "confidence": {
      "$ref": "#/$defs/probability"
    },
    "risk_score": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "execution_allowed": {
      "type": "boolean"
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0.0
    }
  }
}
